# Copy to .env and fill in. Never commit .env (it holds secrets).

# --- Supabase (backend) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx          # server only — bypasses RLS
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT

# --- Store settings (Admin → Settings overrides each when filled in) ---
SITE_URL=https://your-domain.com
TELEGRAM_BOT_USERNAME=yourbot
TELEGRAM_OWNER_IDS=123456789            # bot admins (Telegram chat ids, comma-separated)
TELEGRAM_NOTIFY_GROUP=                  # optional, e.g. -1001234567890
DEPOSIT_ADDRESS=0x...                   # crypto deposit wallet (BEP20/Polygon)

# --- Store owners (comma-separated; both copies required) ---
OWNER_EMAILS=owner@example.com
VITE_OWNER_EMAILS=owner@example.com
REVOKED_ADMIN_EMAILS=
VITE_REVOKED_ADMIN_EMAILS=

# --- Reseller supplier API keys (server only; optional per shop) ---
PROVIDER_QAMIFY_KEY=
PROVIDER_MMOSTORE_KEY=
PROVIDER_SAFWANTIGER_KEY=
PROVIDER_CUPPONHUB_KEY=
PROVIDER_EKLAS_KEY=
# Optional URL overrides (defaults are built in):
# PROVIDER_QAMIFY_URL=
# PROVIDER_MMOSTORE_URL=
# PROVIDER_SAFWANTIGER_URL=
# PROVIDER_CUPPONHUB_URL=
# PROVIDER_EKLAS_URL=

# --- Telegram / payments (optional, set when used) ---
# TELEGRAM_BOT_TOKEN=
